# Server
PORT=3101

# ATEM Fairlight Mic-1 config: disabled, the Mic-1 fader code was removed.
# Kept for reference until the feature is restored or dropped.
# FAIRLIGHT_INPUT=1301
# FAIRLIGHT_SOURCE=-65280
# FAIRLIGHT_FADER_GAIN=-220

# Motorized fader (Arduino Uno over USB serial) -> ATEM master gain
# Leave FADER_PORT empty to auto-detect the Uno (e.g. /dev/cu.usbmodem14101)
FADER_PORT=
FADER_BAUD=115200
# ATEM target per fader channel, comma-separated: master, mic1, mic2 or <input>/<source>
FADER_CHANNELS=master
# Display-only channels for the board's 0.96" OLED (levels, input gain, pan); unset = mic1,mic2
# FADER_MONITOR=mic1,mic2
# 1 = log every serial line to and from the fader board
FADER_DEBUG=

# OBS WebSocket (built into OBS v28+)
OBS_URL=ws://localhost:4455
OBS_PASSWORD=

# OBS program preview in idle MSG box
OBS_PREVIEW_INTERVAL=3000
OBS_PREVIEW_WIDTH=320
OBS_PREVIEW_QUALITY=30
